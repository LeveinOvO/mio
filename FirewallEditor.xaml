<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="PortForwarder.FirewallEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="配置防火墙规则" PrimaryButtonText="预览并保存" CloseButtonText="取消"
    DefaultButton="Close" PrimaryButtonClick="Save_Click">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" MinWidth="380" MaxWidth="480">
            <TextBlock x:Name="ListenerText" TextWrapping="Wrap" FontWeight="SemiBold" />
            <RadioButton x:Name="CidrMode" Content="指定来源 CIDR（必填）" GroupName="Sources" IsChecked="True" Checked="SourceMode_Changed" />
            <TextBox x:Name="CidrBox" Header="允许的来源 IPv4 CIDR" AcceptsReturn="True" MinHeight="80"
                     PlaceholderText="例如 192.168.2.0/24 或 100.64.1.11/32&#xA;多个 CIDR 用换行、逗号或空格分隔" TextWrapping="Wrap" />
            <RadioButton x:Name="AnyMode" Content="允许任意来源 IP" GroupName="Sources" Checked="SourceMode_Changed" />
            <TextBlock Text="不限制来源 IP 时，选择“允许任意来源 IP”。"
                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="适用的网络配置文件（至少选一项）" />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="PrivateProfile" Content="专用" IsChecked="True" />
                <CheckBox x:Name="DomainProfile" Content="域" />
                <CheckBox x:Name="PublicProfile" Content="公用" />
            </StackPanel>
            <TextBlock x:Name="LifecycleText" TextWrapping="Wrap" FontSize="12" />
            <TextBlock x:Name="ExistingText" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="RemoveButton" Content="删除防火墙规则" Click="Remove_Click" Visibility="Collapsed"
                    ToolTipService.ToolTip="删除对应的防火墙规则，保留端口转发。" />
            <InfoBar x:Name="ValidationMessage" IsOpen="False" IsClosable="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
