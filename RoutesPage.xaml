<Page x:Class="PortForwarder.RoutesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:core="using:PortForwarder.Core">
    <Grid Padding="28,16,28,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="AddButton" Content="添加路由" Click="Add_Click" Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="EditButton" Content="编辑" Click="Edit_Click" IsEnabled="False"/>
            <Button x:Name="DeleteButton" Content="删除" Click="Delete_Click" IsEnabled="False"/>
            <Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click"/>
            <ComboBox x:Name="CategoryBox" Width="180" SelectedIndex="0" SelectionChanged="Category_Changed">
                <ComboBoxItem Content="全部路由"/>
                <ComboBoxItem Content="手动静态路由"/>
                <ComboBoxItem Content="系统 / 其他路由"/>
            </ComboBox>
            <TextBox x:Name="FilterBox" Width="260" PlaceholderText="筛选网段、下一跳或网卡" TextChanged="Filter_Changed"/>
            <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False"/>
        </StackPanel>
        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True"/>
        <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Padding="16,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="100"/><ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="目标网段"/><TextBlock Grid.Column="1" Text="下一跳"/><TextBlock Grid.Column="2" Text="网卡 / 接口"/>
                    <TextBlock Grid.Column="3" Text="路由 Metric"/><TextBlock Grid.Column="4" Text="接口 Metric"/><TextBlock Grid.Column="5" Text="有效 Metric"/>
                    <TextBlock Grid.Column="6" Text="保存方式"/><TextBlock Grid.Column="7" Text="类型"/>
                </Grid>
                <ListView x:Name="RouteList" Grid.Row="1" SelectionMode="Single" SelectionChanged="Selection_Changed" HorizontalContentAlignment="Stretch">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="16,10"/></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:RouteEntry">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/><ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind DestinationPrefix}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind NextHop}"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind InterfaceText}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind InterfaceText}"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind RouteMetric}"/><TextBlock Grid.Column="4" Text="{x:Bind InterfaceMetric}"/><TextBlock Grid.Column="5" Text="{x:Bind EffectiveMetric}"/>
                                <TextBlock Grid.Column="6" Text="{x:Bind StoreText}"/><TextBlock Grid.Column="7" Text="{x:Bind TypeText}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        <Grid Grid.Row="3">
            <TextBlock Text="IPv4 · 系统路由只读 · 有效 Metric = 路由 Metric + 接口 Metric" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="CountText" HorizontalAlignment="Right" FontSize="12"/>
        </Grid>
    </Grid>
</Page>
