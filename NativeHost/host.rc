#include "build/version.h"
1 24 "host.manifest"
101 ICON "../Assets/AppIcon.ico"

1 VERSIONINFO
 FILEVERSION MIO_VERSION_NUM
 PRODUCTVERSION MIO_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Mio"
            VALUE "FileDescription", "Mio native host"
            VALUE "FileVersion", MIO_FILE_VERSION
            VALUE "InternalName", "Mio.Host.exe"
            VALUE "OriginalFilename", "Mio.Host.exe"
            VALUE "ProductName", "Mio"
            VALUE "ProductVersion", MIO_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
